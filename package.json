{
  "name": "turbase-presentations",
  "version": "1.0.0",
  "description": "Turbase Sovereign Presentation Suite, Interactive Decks & Media Generation Engine",
  "private": true,
  "scripts": {
    "rebuild-overall": "npm run rebuild-overall-architecture && npm run rebuild-overall-stakeholder && npm run rebuild-overall-architecture-doc && npm run rebuild-overall-stakeholder-doc",
    "rebuild-overall-architecture": "node scripts/rebuild.js overall_presentations/01_sovereign_architecture_presentation",
    "rebuild-overall-stakeholder": "node scripts/rebuild.js overall_presentations/02_stakeholders_benefits_presentation",
    "rebuild-overall-stakeholder-doc": "node overall_presentations/02_stakeholders_benefits_presentation/scripts/generate_stakeholders_matrix_pdf.js",
    "rebuild-overall-architecture-doc": "node overall_presentations/01_sovereign_architecture_presentation/scripts/generate_architecture_doc_pdf.js",
    "rebuild-all": "node scripts/rebuild.js all",
    "rebuild-all:force": "node scripts/rebuild.js all --force",
    "regen-overall": "npm run regen-overall-architecture && npm run regen-overall-stakeholder && npm run regen-overall-architecture-doc && npm run regen-overall-stakeholder-doc",
    "regen-overall-architecture": "node scripts/regenerate.js overall_presentations/01_sovereign_architecture_presentation",
    "regen-overall-stakeholder": "node scripts/regenerate.js overall_presentations/02_stakeholders_benefits_presentation",
    "regen-overall-stakeholder-doc": "node overall_presentations/02_stakeholders_benefits_presentation/scripts/generate_stakeholders_matrix_pdf.js",
    "regen-overall-architecture-doc": "node overall_presentations/01_sovereign_architecture_presentation/scripts/generate_architecture_doc_pdf.js",
    "regenerate-all": "node scripts/regenerate.js all",
    "regenerate-all:force": "node scripts/regenerate.js all --full-regeneration",
    "install:build": "./install_build_dependencies.sh",
    "install:regen": "./install_regen_dependencies.sh"
  },
  "dependencies": {
    "node-edge-tts": "^1.2.10",
    "playwright": "^1.42.0"
  }
}
